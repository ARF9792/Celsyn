{
  "name": "chainpulse",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time cold-chain fleet telemetry monitoring platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,green \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace server",
    "start": "npm run start --workspace server",
    "simulate": "npm run simulate --workspace server --",
    "stress": "npm run stress --workspace server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}

